Windows Registry Editor Version 5.00

; Putty Theme Alucard
; Scheme author: clach04
; scheme-comment:  Based on https://draculatheme.com/spec#ansi-color-palette Alucard (Dracula light variant)
; scheme-comment1: Straight mapping of ANSI values from specification 2026-03-27
; scheme-comment2: Reference https://github.com/dracula/dracula-theme
; scheme-comment3: Reference https://github.com/dracula/draculatheme.com/blob/main/content/spec.mdx
; scheme-comment4: Unused: Selection : #CFCFDE - Official Alucard selection is not a config option for Putty
; scheme-comment5: Unused: Orange : #A34D14 - Official Alucard orange not part of the ANSI 16-color palette
; scheme-comment6: Source for https://github.com/clach04/dracula_putty
[HKEY_CURRENT_USER\Software\SimonTatham\PuTTY\Sessions\Alucard]

; Default Foreground
;  Colour0-comment: Default Foreground
;     Colour0-note: Alucard Foreground
;          Colour0: #1f1f1f
"Colour0"="31,31,31"

; Default Bold Foreground  -- equals to non-bold
;  Colour1-comment: Default Bold Foreground  -- equals to non-bold
;     Colour1-note: Alucard Foreground
;          Colour1: #1f1f1f
"Colour1"="31,31,31"

; Default Background
;  Colour2-comment: Default Background
;     Colour2-note: Alucard Background
;          Colour2: #fffbeb
"Colour2"="255,251,235"

; Default Bold Background  -- equals to non-bold
;  Colour3-comment: Default Bold Background  -- equals to non-bold
;     Colour3-note:
;          Colour3: #fffbeb
"Colour3"="255,251,235"

; Cursor Text -- equals to default background
;  Colour4-comment: Cursor Text -- equals to default background
;     Colour4-note:
;          Colour4: #fffbeb
"Colour4"="255,251,235"

; Cursor Colour -- equals to default foreground
;  Colour5-comment: Cursor Colour -- equals to default foreground
;     Colour5-note: Alucard Foreground
;          Colour5: #1f1f1f
"Colour5"="31,31,31"

